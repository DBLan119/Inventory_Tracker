<Window x:Class="QuanLyKho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuanLyKho.ViewModels"
        xmlns:models="clr-namespace:QuanLyKho.Models"
        xmlns:local="clr-namespace:QuanLyKho"
        Title="Quản Lý Kho" 
        Height="768" Width="1366"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15">
            <Grid>
                <TextBlock Text="HỆ THỐNG QUẢN LÝ KHO" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="💰 CÔNG NỢ" 
                            Command="{Binding OpenDebtCommand}"
                            Background="#DC3545" 
                            Foreground="White" 
                            Padding="15,8" 
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#c82333"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="ĐĂNG XUẤT" 
                            Command="{Binding LogoutCommand}"
                            Background="#f44336" 
                            Foreground="White" 
                            Padding="15,8" 
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#da190b"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Input Form -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="#AAAAAA" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="THÔNG TIN GIAO DỊCH" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <!-- Date -->
                    <TextBlock Text="Ngày:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding SelectedDate}" 
                                Padding="8" 
                                Margin="0,0,0,15"/>

                    <!-- Dealer Name -->
                    <TextBlock Text="Tên đại lý:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding DealerName, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8" 
                             Margin="0,0,0,15"/>

                    <!-- Item Name -->
                    <TextBlock Text="Tên mặt hàng:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8" 
                             Margin="0,0,0,15"/>

                    <!-- Quantity -->
                    <TextBlock Text="Số lượng:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="QuantityTextBox"
                             Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8" 
                             Margin="0,0,0,15"
                             PreviewTextInput="NumberValidationTextBox"
                             DataObject.Pasting="TextBoxPasting"/>

                    <!-- Amount -->
                    <TextBlock Text="Số tiền (VNĐ):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="AmountTextBox"
                             Text="{Binding Amount, UpdateSourceTrigger=LostFocus}" 
                             Padding="8" 
                             Margin="0,0,0,20"
                             PreviewTextInput="NumberValidationTextBox"
                             DataObject.Pasting="TextBoxPasting"
                             TextChanged="AmountTextBox_TextChanged"
                             GotFocus="AmountTextBox_GotFocus"
                             LostFocus="AmountTextBox_LostFocus"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="NHẬP KHO" 
                                Grid.Column="0"
                                Command="{Binding ImportCommand}"
                                PreviewMouseDown="Button_PreviewMouseDown"
                                Background="#4CAF50" 
                                Foreground="White" 
                                Padding="12" 
                                FontSize="14" 
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#45a049"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#CCCCCC"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="XUẤT KHO" 
                                Grid.Column="2"
                                Command="{Binding ExportCommand}"
                                PreviewMouseDown="Button_PreviewMouseDown"
                                Background="#FF9800" 
                                Foreground="White" 
                                Padding="12" 
                                FontSize="14" 
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#e68900"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#CCCCCC"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Button Content="XÓA GIAO DỊCH" 
                            Command="{Binding DeleteCommand}"
                            PreviewMouseDown="Button_PreviewMouseDown"
                            Margin="0,10,0,0"
                            Background="#f44336" 
                            Foreground="White" 
                            Padding="12" 
                            FontSize="14" 
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Xóa 1 giao dịch đã chọn">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#da190b"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#CCCCCC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="XÓA NHIỀU GIAO DỊCH" 
                            Command="{Binding DeleteMultipleCommand}"
                            Margin="0,10,0,0"
                            Background="#9C27B0" 
                            Foreground="White" 
                            Padding="12" 
                            FontSize="14" 
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Xóa nhiều giao dịch đã chọn (Ctrl + Click để chọn nhiều)">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#7B1FA2"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#CCCCCC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right Panel - Transaction List -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#AAAAAA" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Month/Year Selection -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Tháng:" 
                                   Grid.Column="0" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding Months}"
                                  SelectedItem="{Binding SelectedMonth}"
                                  Padding="8"/>

                        <TextBlock Text="Năm:" 
                                   Grid.Column="3" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="4" 
                                  ItemsSource="{Binding Years}"
                                  SelectedItem="{Binding SelectedYear}"
                                  Padding="8"/>

                        <Button Grid.Column="5"
                                Content="📊 XUẤT EXCEL"
                                Command="{Binding ExportToExcelCommand}"
                                Background="#4CAF50"
                                Foreground="White"
                                Padding="15,8"
                                FontSize="12"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                ToolTip="Xuất dữ liệu tháng hiện tại ra file Excel">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#45a049"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Filter Section -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🔍 Lọc theo đại lý:" 
                                   Grid.Column="0" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding FilterDealerName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"
                                 FontSize="14"
                                 VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#2196F3"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- Transaction List -->
                    <DataGrid Grid.Row="2" 
                              x:Name="TransactionsDataGrid"
                              ItemsSource="{Binding Transactions}"
                              SelectedItem="{Binding SelectedTransaction}"
                              SelectionMode="Extended"
                              SelectionChanged="TransactionsDataGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F9F9F9"
                              CanUserResizeRows="False"
                              FontSize="14"
                              RowHeight="35">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="35"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày" 
                                                Binding="{Binding Date, StringFormat=dd/MM/yyyy}" 
                                                Width="110"/>
                            <DataGridTextColumn Header="Loại" 
                                                Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Type">
                                        <Binding.Converter>
                                            <local:TransactionTypeConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Đại lý" 
                                                Binding="{Binding DealerName}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Mặt hàng" 
                                                Binding="{Binding ItemName}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Số lượng" 
                                                Binding="{Binding Quantity}" 
                                                Width="90"/>
                            <DataGridTextColumn Header="Số tiền" 
                                                Binding="{Binding Amount, StringFormat=N0}" 
                                                Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary -->
                    <Border Grid.Row="3" 
                            Background="#E3F2FD" 
                            Padding="20" 
                            CornerRadius="5"
                            Margin="0,15,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tổng nhập kho:" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding TotalImport, StringFormat={}{0:N0} VNĐ}" 
                                           FontSize="18" 
                                           Foreground="#4CAF50"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Tổng xuất kho:" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding TotalExport, StringFormat={}{0:N0} VNĐ}" 
                                           FontSize="18" 
                                           Foreground="#FF9800"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Chênh lệch:" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding Balance, StringFormat={}{0:N0} VNĐ}" 
                                           FontSize="18" 
                                           Foreground="#2196F3"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2196F3" Padding="10">
            <TextBlock Text="© 2026 Hệ Thống Quản Lý Kho" 
                       Foreground="White" 
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
</Window>
