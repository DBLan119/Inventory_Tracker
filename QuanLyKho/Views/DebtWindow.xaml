<Window x:Class="QuanLyKho.Views.DebtWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuanLyKho.ViewModels"
        xmlns:local="clr-namespace:QuanLyKho.Views"
        Title="Quản Lý Công Nợ" 
        Height="768" Width="1366"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Window.DataContext>
        <vm:DebtViewModel/>
    </Window.DataContext>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#DC3545" Padding="15">
            <Grid>
                <TextBlock Text="QUẢN LÝ CÔNG NỢ" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button Content="ĐÓNG" 
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#6c757d" 
                        Foreground="White" 
                        Padding="15,8" 
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5a6268"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Add Debt -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="#AAAAAA" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="THÊM CÔNG NỢ MỚI" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#DC3545"
                               Margin="0,0,0,20"/>

                    <!-- Purchase Date -->
                    <TextBlock Text="Ngày mua:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding PurchaseDate}" 
                                Padding="8" 
                                Margin="0,0,0,15"/>

                    <!-- Customer Name -->
                    <TextBlock Text="Tên khách hàng: *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8" 
                             Margin="0,0,0,15"/>

                    <!-- Item Name -->
                    <TextBlock Text="Mặt hàng (không bắt buộc):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8" 
                             Margin="0,0,0,15"/>

                    <!-- Debt Amount -->
                    <TextBlock Text="Số tiền nợ (VNĐ): *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="DebtAmountTextBox"
                             Text="{Binding DebtAmount, UpdateSourceTrigger=LostFocus}" 
                             Padding="8" 
                             Margin="0,0,0,20"
                             PreviewTextInput="NumberValidationTextBox"
                             DataObject.Pasting="TextBoxPasting"
                             TextChanged="DebtAmountTextBox_TextChanged"
                             GotFocus="DebtAmountTextBox_GotFocus"
                             LostFocus="DebtAmountTextBox_LostFocus"/>

                    <!-- Action Buttons -->
                    <Button Content="THÊM CÔNG NỢ" 
                            Command="{Binding AddDebtCommand}"
                            PreviewMouseDown="Button_PreviewMouseDown"
                            Background="#DC3545" 
                            Foreground="White" 
                            Padding="12" 
                            FontSize="14" 
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#c82333"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#CCCCCC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="ĐÁNH DẤU ĐÃ TRẢ" 
                            Command="{Binding MarkAsPaidCommand}"
                            PreviewMouseDown="Button_PreviewMouseDown"
                            Margin="0,10,0,0"
                            Background="#28a745" 
                            Foreground="White" 
                            Padding="12" 
                            FontSize="14" 
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#218838"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#CCCCCC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="XÓA CÔNG NỢ" 
                            Command="{Binding DeleteDebtCommand}"
                            PreviewMouseDown="Button_PreviewMouseDown"
                            Margin="0,10,0,0"
                            Background="#6c757d" 
                            Foreground="White" 
                            Padding="12" 
                            FontSize="14" 
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5a6268"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#CCCCCC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="XÓA NHIỀU CÔNG NỢ" 
                            Command="{Binding DeleteMultipleDebtsCommand}"
                            Margin="0,10,0,0"
                            Background="#9C27B0" 
                            Foreground="White" 
                            Padding="12" 
                            FontSize="14" 
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Xóa nhiều công nợ đã chọn (Ctrl + Click để chọn nhiều)">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#7B1FA2"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#CCCCCC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right Panel - Debt List -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#AAAAAA" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Section -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Lọc theo tên:" 
                                   Grid.Column="0" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding FilterCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"
                                 Margin="0,0,10,0"/>
                        <Button Grid.Column="2"
                                Content="Xóa lọc"
                                Command="{Binding ClearFilterCommand}"
                                Background="#6c757d"
                                Foreground="White"
                                Padding="10,5"
                                FontSize="12"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="3"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#5a6268"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="3"
                                Content="📊 XUẤT EXCEL"
                                Command="{Binding ExportToExcelCommand}"
                                Background="#4CAF50"
                                Foreground="White"
                                Padding="15,8"
                                FontSize="12"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#45a049"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Debt List -->
                    <DataGrid Grid.Row="1" 
                              x:Name="DebtsDataGrid"
                              ItemsSource="{Binding Debts}"
                              SelectedItem="{Binding SelectedDebt}"
                              SelectionMode="Extended"
                              SelectionChanged="DebtsDataGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F9F9F9"
                              CanUserResizeRows="False"
                              FontSize="14"
                              RowHeight="35">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="35"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày mua" 
                                                Binding="{Binding PurchaseDate, StringFormat=dd/MM/yyyy}" 
                                                Width="110"/>
                            <DataGridTextColumn Header="Khách hàng" 
                                                Binding="{Binding CustomerName}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Mặt hàng" 
                                                Binding="{Binding ItemName}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Số tiền nợ" 
                                                Binding="{Binding DebtAmount, StringFormat=N0}" 
                                                Width="140"/>
                            <DataGridTextColumn Header="Trạng thái" 
                                                Width="120">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="IsPaid">
                                        <Binding.Converter>
                                            <local:DebtStatusConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaid}" Value="False">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary -->
                    <Border Grid.Row="2" 
                            Background="#FFE5E5" 
                            Padding="20" 
                            CornerRadius="5"
                            Margin="0,15,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Tổng nợ còn lại:" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalDebt, StringFormat={}{0:N0} VNĐ}" 
                                           FontSize="24" 
                                           Foreground="#DC3545"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Tổng nợ:" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalAllDebt, StringFormat={}{0:N0} VNĐ}" 
                                           FontSize="24" 
                                           Foreground="#6c757d"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#DC3545" Padding="10">
            <TextBlock Text="© 2026 Hệ Thống Quản Lý Kho - Quản Lý Công Nợ" 
                       Foreground="White" 
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
</Window>
